{
  "name": "certi-ueeh-boletines",
  "version": "1.0.0",
  "description": "Modulo de Generación de Boletines Trimestrales - UEEH",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "build:dir": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps || echo postinstall-skip"
  },
  "keywords": [
    "electron",
    "python",
    "excel",
    "reportlab",
    "school"
  ],
  "author": "Econ. Pablo Juca",
  "license": "ISC",
  "devDependencies": {
    "electron": "33.3.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ec.edu.ueeh.certi",
    "productName": "CERTI_UEEH",
    "asar": true,
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "asistencia.js",
      "asistencia_ui.js",
      "procesador_notas.py",
      "catalogo_asignaturas.py",
      "catalogo_asignaturas.json",
      "escala_cualitativa.json",
      "requirements.txt",
      "assets/certificados/**/*",
      "!assets/formatos-notas/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/formatos-notas",
        "to": "assets/formatos-notas",
        "filter": [
          "*.xlsx"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CERTI_UEEH-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
